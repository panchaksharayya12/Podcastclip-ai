# ClipForge AI Environment Configuration

# Server Port
PORT=5000

# OpenAI Configuration (Optional: application operates in full deterministic transcript-based mode without this)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Upload Limits (in megabytes)
MAX_UPLOAD_MB=500

# Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional Supabase Integration for future-ready storage
SUPABASE_URL=
SUPABASE_ANON_KEY=

